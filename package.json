{
  "name": "@allin-ai/agentkit-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "hub": "tsx packages/hub/src/cli/main.ts web",
    "hub:dev": "tsx packages/hub/src/cli/main.ts web --dev",
    "client": "tsx packages/client/src/cli/main.ts",
    "build": "node scripts/build.mjs",
    "test": "tsx --tsconfig ./tsconfig.json --test 'packages/*/src/**/*.test.ts' 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/hub/web/tsconfig.json",
    "publish:stage": "node scripts/publish-stage.mjs publish",
    "verify:artifact": "node scripts/publish-stage.mjs stage && node scripts/verify-package-artifact.mjs",
    "test:web": "tsx --tsconfig packages/hub/web/tsconfig.json --test packages/hub/web/server.test.ts",
    "verify:artifact:offline": "node scripts/publish-stage.mjs stage && node scripts/verify-package-artifact.mjs --offline"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@openai/codex-sdk": "^0.156.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.14",
    "react": "^19.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "ws": "^8.18.0",
    "@allin-ai/agentkit-hub": "workspace:*",
    "@allin-ai/agentkit-client": "workspace:*",
    "@types/react-dom": "^19.0.0"
  }
}
